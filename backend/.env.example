# Copy to .env and adjust. NEVER put the upstream token in this file.
# The upstream token is read ONLY from the USER_TOKEN environment variable.
PORT=8787
HOST=0.0.0.0
# Upstream API base URL
UPSTREAM_BASE_URL=https://api.one-api.ir/radiojavan/v1
# Timeout (ms) for upstream JSON API calls
UPSTREAM_TIMEOUT_MS=10000
# Timeout (ms) to receive response headers from the media CDN when proxying downloads
MEDIA_TIMEOUT_MS=15000
# Cache TTL (seconds) for list endpoints (home, trending, featured, popular, search, ...)
CACHE_TTL_SECONDS=180
# Cache TTL (seconds) for single items (track/album/playlist/...). Also lets download/seek
# requests reuse the track lookup instead of calling the upstream API every time.
ITEM_CACHE_TTL_SECONDS=900
# Max number of cached entries
CACHE_MAX_ENTRIES=500
LOG_LEVEL=info

# --- Accounts (SQLite). None of these are required for a first boot. ---
# Directory for melobi.db, avatars/, and session.secret.
# Production: create this outside the app folder so a redeploy does not wipe accounts.
# If unset, the server uses /opt/melobi/data when that path is writable, otherwise backend/data.
# MELOBI_DATA_DIR=/opt/melobi/data
#
# Optional HMAC key for session cookies. If unset, a random key is written to
# $MELOBI_DATA_DIR/session.secret (mode 0600) and reused across restarts.
# Set this yourself if more than one process must validate the same cookies.
# SESSION_SECRET=
#
# Session cookie Secure flag. Unset = on only when X-Forwarded-Proto is https
# (Caddy in front of the app). Set 1 to force Secure, or 0 for plain HTTP.
# COOKIE_SECURE=
