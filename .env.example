# Absolute origin of the music backend, no trailing slash.
# Leave empty in local dev: the app calls /api/v1 and Vite proxies to API_PROXY_TARGET.
# Set this when building for production, for example https://music-api.example.com
VITE_API_BASE_URL=

# Where `vite dev` and `vite preview` proxy /api/v1. Not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8787

# Upstream token for backend/ only. Never put this in a frontend env var or commit it.
# USER_TOKEN=

# Account storage is configured on the API process. See backend/.env.example
# (MELOBI_DATA_DIR, SESSION_SECRET, COOKIE_SECURE). Keep the API on the same
# site as the page so the session cookie is first-party.
